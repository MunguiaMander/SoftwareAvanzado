# Copiar a .env antes del primer arranque.

SERVER_PORT=8080

# Debe coincidir con el puerto donde corre el frontend.
CORS_ALLOWED_ORIGIN=http://localhost:4200

DB_NAME=sessiondb
DB_USERNAME=sa
DB_PASSWORD=

# Corta a proposito para demostrar la expiracion en vivo.
SESSION_TIMEOUT=2m

# Requiere HTTPS cuando esta en true.
COOKIE_SECURE=false

H2_CONSOLE_ENABLED=true
SHOW_SQL=true
