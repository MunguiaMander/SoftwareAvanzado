{
  "realm": "poc-saml",
  "enabled": true,
  "displayName": "POC SAML - Software Avanzado",
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "http://localhost:8083/saml2/service-provider-metadata/samltest",
      "name": "POC Spring SP",
      "protocol": "saml",
      "enabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:8083/*"
      ],
      "baseUrl": "http://localhost:8083",
      "attributes": {
        "saml.client.signature": "true",
        "saml.signing.certificate": "",
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_name_id_format": "email",
        "saml.authnstatement": "true",
        "saml_assertion_consumer_url_post": "http://localhost:8083/login/saml2/sso/samltest",
        "saml_single_logout_service_url_post": "http://localhost:8083/logout/saml2/slo",
        "saml.encrypt": "false",
        "saml.force.post.binding": "true"
      },
      "protocolMappers": [
        {
          "name": "mail",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "friendly.name": "E-Mail",
            "attribute.name": "mail",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "givenName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "friendly.name": "Given Name",
            "attribute.name": "givenName",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "surname",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "friendly.name": "Surname",
            "attribute.name": "surname",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "roles",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "consentRequired": false,
          "config": {
            "attribute.name": "Role",
            "attribute.nameformat": "Basic",
            "single": "false"
          }
        },
        {
          "name": "department",
          "protocol": "saml",
          "protocolMapper": "saml-user-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "department",
            "friendly.name": "Department",
            "attribute.name": "department",
            "attribute.nameformat": "Basic"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "empleado"
      },
      {
        "name": "gerente"
      }
    ]
  },
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "emailVerified": true,
      "email": "ana@empresa-demo.com",
      "firstName": "Ana",
      "lastName": "Ramirez",
      "attributes": {
        "department": [
          "Ingenieria"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "ana123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "empleado",
        "gerente"
      ]
    },
    {
      "username": "luis",
      "enabled": true,
      "emailVerified": true,
      "email": "luis@empresa-demo.com",
      "firstName": "Luis",
      "lastName": "Torres",
      "attributes": {
        "department": [
          "Ventas"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "luis123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "empleado"
      ]
    }
  ]
}